aws_region         = "ap-south-1"
project_name       = "gitops-dr-simulator"

vpc_cidr           = "10.0.0.0/16"
public_subnet_cidr = "10.0.1.0/24"

instance_type = "t3.micro"

# Create this key pair in ap-south-1 before planning/applying.
key_name = "replace-with-existing-key-pair-name"

# Find your public IPv4 address with: curl https://checkip.amazonaws.com
ssh_allowed_cidr = "YOUR_PUBLIC_IP/32"
